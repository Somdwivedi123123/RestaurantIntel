rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isValidImageUpload() {
      return request.resource.size < 5 * 1024 * 1024 // 5MB
        && request.resource.contentType.matches('image/.*');
    }

    function isValidDocumentUpload() {
      return request.resource.size < 10 * 1024 * 1024 // 10MB
        && request.resource.contentType.matches('application/pdf|text/.*');
    }

    // Restaurant images (menu items, photos)
    match /restaurants/{restaurantId}/images/{imageId} {
      allow read: if true; // Public read for menu images
      allow write: if isAuthenticated() && isValidImageUpload();
    }

    // User uploads
    match /users/{userId}/uploads/{fileName} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Reports and documents
    match /restaurants/{restaurantId}/reports/{reportId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isValidDocumentUpload();
    }

    // Competitor data
    match /competitors/{competitorId}/data/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
  }
}
